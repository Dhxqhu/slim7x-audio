[Unit]
Description=Apply Slim 7x speaker gains (crossover path)
After=wireplumber.service pipewire.service sound.target
Wants=wireplumber.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Apply once as soon as PipeWire is up. Delayed re-applies used to
# sleep 15s and block default.target (and waybar). slim7x-speaker-guard
# re-applies when UCM/mixer resets gains.
ExecStart=%h/.local/bin/slim7x-speaker-gains

[Install]
WantedBy=default.target
